<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>preview</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameReferencesPath Condition="'$(GameReferencesPath)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..\Desktop\Important\SCPSL-DLLs\SCP Secret Laboratory</GameReferencesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp-Publicized">
      <HintPath>$(GameReferencesPath)\Assembly-CSharp-Publicized.dll</HintPath>
    </Reference>
    <Reference Include="Mirror-Publicized">
      <HintPath>$(GameReferencesPath)\Mirror-Publicized.dll</HintPath>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(GameReferencesPath)\NorthwoodLib.dll</HintPath>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(GameReferencesPath)\Pooling.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule-Publicized">
      <HintPath>$(GameReferencesPath)\UnityEngine.CoreModule-Publicized.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
